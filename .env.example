# ===========================================
# FlagForge CTF Platform - Environment Variables
# ===========================================
# Copy this file to .env and update with your values

# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=flagforge
MYSQL_USER=flagforge_user
MYSQL_PASSWORD=flagforge_password
MYSQL_PORT=3306

# Database URL for Prisma (used by backend)
DATABASE_URL=mysql://flagforge_user:flagforge_password@localhost:3306/flagforge

# Redis Configuration (optional, for advanced rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Backend Configuration
NODE_ENV=development
BACKEND_PORT=4000

# JWT & Security Secrets (CHANGE THESE IN PRODUCTION!)
# Generate secure secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-use-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-use-minimum-32-chars
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your-super-secret-cookie-key-change-in-production-use-minimum-32-chars
CSRF_SECRET=your-super-secret-csrf-key-change-in-production-use-minimum-32-chars

# CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
FLAG_SUBMIT_RATE_LIMIT=5

# File Upload Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./backend/uploads
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.pdf,.txt,.zip,.tar,.gz

# Security Headers
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_DIR=./backend/logs

# Frontend Configuration (for docker build)
VITE_API_URL=http://localhost:4000/api
FRONTEND_PORT=5173

# 2FA Configuration (optional)
TOTP_ISSUER=FlagForge
TOTP_WINDOW=1

# Admin Default Credentials (CHANGE ON FIRST LOGIN!)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@flagforge.uz
DEFAULT_ADMIN_PASSWORD=AdminPass123!

# Maintenance Mode
MAINTENANCE_MODE=false

# Flag Hashing (scrypt parameters - DO NOT CHANGE after production deployment)
FLAG_HASH_SALT_LENGTH=32
FLAG_HASH_KEY_LENGTH=64
FLAG_HASH_N=16384
FLAG_HASH_R=8
FLAG_HASH_P=1
